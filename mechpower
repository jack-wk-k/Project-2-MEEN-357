def tau_dcmotor(omega, motor):
    """
    Calculate DC motor torque from angular velocity.
    """

    if type(motor) != dict:
        raise Exception('Motor must be a dictionary')

    if type(omega) == np.ndarray:
        if len(omega.shape) != 1:
            raise Exception('omega must be a 1D array')
    elif type(omega) != int and type(omega) != float:
        raise Exception('omega must be a scalar or numpy array')

    # Motor parameters
    tau_stall = motor['torque_stall']
    tau_noload = motor['torque_noload']
    omega_noload = motor['speed_noload']

    # Calculate motor torque
    omega = np.asarray(omega, dtype=float)

    tau = tau_stall - (
        (tau_stall - tau_noload) / omega_noload
    ) * omega

    # Torque is zero above no-load speed
    tau = np.where(omega >= omega_noload, 0, tau)

    # Return scalar or array
    if tau.ndim == 0:
        return float(tau)
    else:
        return tau


